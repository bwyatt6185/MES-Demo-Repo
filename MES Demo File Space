    ("bronze_pbm_mdrp_rebates", "mdrp_rebate_invoicing.csv", "csv"),
    ("bronze_pse_provider_registry", "provider_credential_registry.csv", "csv"),
    ("bronze_pse_network_adequacy", "network_adequacy_geospatial.csv", "csv"),
    ("bronze_care_evv_telemetry", "evv_telemetry.json", "json"),
    ("bronze_care_clinical_sdoh", "clinical_sdoh_assessments.txt", "pipe")
]

for table_name, file_name, fmt in sources:
    path = f"{unified_landing}/{file_name}"
    if fmt == "csv":
        df = spark.read.format("csv").option("header", "true").option("inferSchema", "true").load(path)
    elif fmt == "pipe":
        df = spark.read.option("sep", "|").option("header", "true").csv(path)
    elif fmt == "json":
        df = spark.read.json(path)
    df.write.format("delta").mode("overwrite").saveAsTable(table_name)
    print(f"Registered table: {table_name}")

print("All Bronze tables successfully loaded from single location.")
