    ("bronze_surs_collusive_graph", "collusive_network_graph.json", "json"),
    ("bronze_finance_cms64_expenditures", "cms64_quarterly_expenditures.csv", "csv"),
    ("bronze_finance_tmsis_summary", "tmsis_claims_summary.csv", "csv"),
